{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hint.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/hint.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/templates/hooks/approval_capture.py\" --plugin 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/templates/hooks/approval_capture.py\" --plugin",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
