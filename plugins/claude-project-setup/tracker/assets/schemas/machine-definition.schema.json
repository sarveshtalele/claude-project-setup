{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "state-machine-tracker machine definition",
  "type": "object",
  "required": [
    "initial",
    "transitions"
  ],
  "additionalProperties": false,
  "properties": {
    "initial": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "stateDescriptions": {
      "type": "object",
      "description": "Optional 1-2 line human description per state, keyed by the exact state string.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "on",
          "to"
        ],
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "on": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "guard": {
            "type": "string",
            "minLength": 1
          },
          "guardScope": {
            "type": "string",
            "enum": [
              "ever",
              "since_entry"
            ],
            "description": "ever (default): guard event recorded any time since the last reset. since_entry: recorded since the machine last entered this transition's `from` state."
          }
        }
      }
    }
  }
}
